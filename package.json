{
  "name": "supplement-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "db:temp": "bun scripts/dev-mongo.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed:admin": "bun scripts/seed-admin.ts",
    "seed:settings": "bun scripts/seed-settings.ts",
    "seed:products": "bun scripts/seed-products.ts",
    "seed:indexes": "bun scripts/sync-indexes.ts",
    "seed": "bun run seed:admin && bun run seed:products && bun run seed:indexes"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "mongoose": "^8.0.0",
    "next": "^15.5.0",
    "react": "19.0.8",
    "react-dom": "19.0.8",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^2.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "mongodb-memory-server": "^11.3.0",
    "postcss": "^8.4.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.0"
  }
