[TEMPLATE]
# ─── Database (MongoDB Atlas free M0) ────────────────────────────────
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/supplement-store?retryWrites=true&w=majority"

# ─── Site ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_NAME="Body Boost Supplements Store"

# ─── Store contact (defaults; owner can override later in Admin → Settings)
# WhatsApp: digits only WITH country code (used to build wa.me links)
NEXT_PUBLIC_WHATSAPP_NUMBER="919266510520"
NEXT_PUBLIC_PHONE_NUMBER="+919266510520"
NEXT_PUBLIC_STORE_ADDRESS="Vikas Puri, Pillokhadi Ka Pull, Meerut 250002"

# ─── Admin seed (scripts/seed-admin.ts) ────────────────────────────────
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# ─── Order notifications (Phase 3) ─────────────────────────────────────
# Both channels are OPTIONAL: each is skipped (and logged) while its vars
# are empty, so orders still succeed without any keys configured.

# Resend email — https://resend.com  ("from" must be a verified sender)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Body Boost <orders@yourdomain.com>"
# New-order inbox (falls back to ADMIN_EMAIL when empty)
ORDER_NOTIFY_EMAIL=""

# Telegram bot — create with @BotFather (/newbot), get your chat id from
# @userinfobot (or /getUpdates after messaging your bot)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ─── Admin auth (Phase 4) ─────────────────────────────────────────────
# Signs the httpOnly session cookie (JWT HS256). Generate with:
#   bun -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# ─── Cloudinary image uploads (Phase 5) ───────────────────────────────
# Server-side signed uploads from Admin → Products. All three are required
# for uploads to work; while empty, POST /api/admin/uploads returns 503 and
# products can still reference existing /public images or full image URLs.
# Dashboard → https://console.cloudinary.com/ (Settings → API Keys)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
